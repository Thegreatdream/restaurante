# Copia este archivo como .env.local y pega tus claves. .env.local NUNCA se sube a GitHub.

# Supabase → tu proyecto → botón "Connect" (o Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Resend → API Keys → Create API Key (permiso "Sending access")
RESEND_API_KEY=re_xxxxxxxx
# Remitente. Sin dominio propio verificado usa: Donde Tato <onboarding@resend.dev>
# (en ese caso Resend solo entrega a tu propio correo).
CORREO_REMITENTE=Donde Tato <pedidos@tudominio.com>

# Dirección de la web en tu computador. En Vercel no hace falta: se detecta sola.
# Si algún día usas dominio propio, agrega en Vercel SITIO_URL=https://tudominio.com
NEXT_PUBLIC_SITIO_URL=http://localhost:3000
